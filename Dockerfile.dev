FROM node:20-alpine

ARG APP_NAME
ENV APP_NAME=${APP_NAME}

WORKDIR /app

RUN npm install -g nodemon

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Build once on start, then watch and restart
CMD sh -c "npx nx run ${APP_NAME}:build --skip-nx-cache && \
           nodemon --watch dist/apps/${APP_NAME} --delay 2 dist/apps/${APP_NAME}/main.js"
